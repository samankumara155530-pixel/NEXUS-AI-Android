
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CAMERA -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- INTERNET -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- MICROPHONE -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO" />

    <!-- FOREGROUND VOICE SERVICE -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- CALENDAR -->
    <uses-permission
        android:name="android.permission.READ_CALENDAR" />

    <uses-permission
        android:name="android.permission.WRITE_CALENDAR" />

    <!-- APP QUERIES -->
    <queries>

        <!-- SPEECH RECOGNITION -->
        <intent>
            <action
                android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>

        <!-- CAMERA -->
        <intent>
            <action
                android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>

        <!-- CALENDAR -->
        <intent>
            <action
                android:name="android.intent.action.INSERT" />

            <data
                android:mimeType="vnd.android.cursor.item/event" />
        </intent>

    </queries>

    <!-- APPLICATION -->
    <application
        android:allowBackup="false"
        android:label="NEXUS AI"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- MAIN ACTIVITY -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- NEXUS VOICE SERVICE -->
        <service
            android:name=".NexusVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
